{
  "name": "nitro-wallet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "postinstall": "prisma generate && nuxt prepare",
    "test:ui": "node --import tsx scripts/verify-ui.ts",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@prisma/client": "6.19.0",
    "@scure/base": "2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "argon2": "^0.44.0",
    "decimal.js": "^10.6.0",
    "h3": "1.15.11",
    "lucide-vue-next": "^0.468.0",
    "nuxt": "4.5.2",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@nuxt/eslint": "^1.9.0",
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/qrcode": "^1.5.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.20.0"
    }
  }
}
